# Copy to .env and fill in your keys. Never commit .env.

# AI provider keys (at least one is required for generation features)
OPENCODE_GO_API_KEY=
OPENCODE_ZEN_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=

# Local dev: disable the FREE monthly token limit (0 = unlimited).
# Without this, the FREE allowance (4000 tokens/month) hard-stops AI calls once
# exhausted. Alternatives: PATCH /api/v1/account/budget-policy {"policy":"NONE"}
# (or `qalab budget-policy set NONE`) — persisted in the DB.
QALAB_AI_FREEMONTHLYTOKENLIMIT=0

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=jdbc:postgresql://localhost:5432/qalab
DATABASE_USERNAME=qalab
DATABASE_PASSWORD=qalab

# Optional: point the frontend at a backend running elsewhere
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Browser origins allowed to call the API (comma-separated). REQUIRED for any
# deployment that is not on http://localhost:3000, otherwise the browser blocks
# every frontend API call. Wildcard "*" is rejected because credentials are on.
# QALAB_CORS_ALLOWED_ORIGINS=https://qa.example.com

# Wall-clock budget for one Playwright run, in seconds. Finite on purpose: a hung
# run otherwise pins a request thread forever. Raise for very large suites.
# QALAB_PLAYWRIGHT_TIMEOUT_SECONDS=600

# Outbound AI HTTP timeouts (ms). Finite on purpose — the default RestTemplate
# uses infinite timeouts, so a stalled provider could never be retried.
# QALAB_AI_CONNECT_TIMEOUT_MS=10000
# QALAB_AI_READ_TIMEOUT_MS=180000

# Where the backend stores collected artifacts per execution
# (screenshots, videos, traces, report.md, report.json). In docker-compose this is
# a named volume, so artifacts survive `docker compose restart`. Without a volume
# every screenshot and generated report is lost on restart.
# QALAB_ARTIFACTS_DIR=/app/artifacts

# Pre-install Playwright browsers into the image (recommended for containers).
# When true, the backend warms up existing workspaces (npm install + browser
# install) in the BACKGROUND after startup. Set false to skip it entirely — the
# workspace is then prepared lazily on first use.
# QALAB_AUTO_INSTALL_PLAYWRIGHT=true

# Deployment (non-localhost) — both are required together.
#
# QALAB_API_BASE_URL is where the BROWSER reaches the backend. It is served at
# runtime from the frontend's /config.js route, so one image works in every
# environment (Next inlines NEXT_PUBLIC_* at build time, so setting that on an
# already-built container does nothing).
# QALAB_API_BASE_URL=https://api.qa.example.com
#
# QALAB_CORS_ALLOWED_ORIGINS is where the browser reaches the FRONTEND, and must
# be allowed by the backend or every /api call is blocked.
# QALAB_CORS_ALLOWED_ORIGINS=https://qa.example.com

# Artifact profile for GENERATED Playwright workspaces. Defaults capture evidence
# for failures only — video+trace for every passing test is expensive and buries
# the failures. A workspace with its own playwright.config.ts is never modified.
# QALAB_PLAYWRIGHT_SCREENSHOT=only-on-failure   # on | off | only-on-failure
# QALAB_PLAYWRIGHT_VIDEO=off                    # on | off | retain-on-failure
# QALAB_PLAYWRIGHT_TRACE=retain-on-failure      # on | off | retain-on-failure

# Playwright worker count for GENERATED workspaces. 0 = auto (cores - 1, min 1).
# Unset, Playwright spawns ~half the cores as browser contexts, which thrashes
# memory and causes timeouts on small hosts. Set explicitly on a shared host.
# QALAB_PLAYWRIGHT_WORKERS=0
# QALAB_PLAYWRIGHT_TEST_TIMEOUT_MS=30000
# QALAB_PLAYWRIGHT_EXPECT_TIMEOUT_MS=5000
