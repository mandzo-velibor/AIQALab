# Copy to .env and fill in your keys. Never commit .env.

# AI provider keys (at least one is required for generation features)
OPENCODE_GO_API_KEY=
OPENCODE_ZEN_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=jdbc:postgresql://localhost:5432/qalab
DATABASE_USERNAME=qalab
DATABASE_PASSWORD=qalab

# Optional: point the frontend at a backend running elsewhere
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
