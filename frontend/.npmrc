# The dependency graph here cannot be resolved by npm's peer solver: it crashes with
# "Cannot read properties of null (reading 'edgesOut')" while building the ideal tree.
# The conflicts it was tripping over are already avoided by the pinned versions —
# vitest 4 accepts @types/node 20, and @vitejs/plugin-react 5 uses @babel/core 7 rather
# than the rolldown plugin that wants @babel/core 8. This flag bypasses the buggy path
# instead of papering over a real conflict, and it is recorded here so `npm ci` in CI
# resolves identically to the install that produced the lockfile.
legacy-peer-deps=true
