#!/usr/bin/env bash
#
# qalab - CLI for the QALabAI Core API.
#
# Commands:
#   init <dir>            create a .qalab.json project config
#   generate --url <url>  generate Playwright tests for a page
#   generate --write      generate and write test files to workspace
#   generate --instruction "<text>" --test-type <api|ui|e2e>  add user guidance/type filter
#   plan --url <url>      generate a test plan
#   plan --instruction "<text>"  pass user guidance to the planner
#   explore --url <url>   explore/analyze a page
#   analyze [--force]     AI analysis of the page
#   execute [--all|--test <id>]  run tests (needs a registered project)
#   report [<executionId>]       list or show a test report
#   intent "<prompt>"     detect intent and run the matching operation
#   budget-policy         show the current budget policy
#   budget-policy set <HARD|SOFT|NONE>  update the budget policy
#   execute --all --healing-analysis   run all tests with self-healing analysis
#   execute --test <id> --healing-analysis  run one test with healing analysis
#   heal <executionId>    analyze a failed run and produce a healing proposal
#   heal-status <proposalId>  show a healing proposal
#   bug-report <executionId>  generate a bug report from a failed test run
#   bug-reports           list bug reports (or by project: bug-reports <projectId>)
#   locator analyze --url <url> --locator '<locator>'  analyze a locator (live uniqueness + quality)
#   locator history [<projectId>] [<fingerprint>]  show locator observation history
#   test <url>            run the full workflow incl. healing + bug report; writes tests
#                          and saves report/bug-report to .qalab/reports/<timestamp>/
#                          Prints a human summary; exits non-zero if tests fail (CI-safe)
#   test <url> --test-type <api|ui|e2e>   restrict the run to one test type
#   test <url> --json     print the raw workflow response instead of the summary
#   test <url> --quiet    print only the report directory
#
# Configuration (environment or .qalab.json):
#   QALAB_API_URL       default http://localhost:8080
#   QALAB_PROJECT_ID    logical project id
#   QALAB_BASE_URL      app base url
#   QALAB_WORKSPACE     workspace path for execution
#   QALAB_DB_ID         registered project id (database) for run/heal
#   QALAB_API_KEY       bearer API key (also "apiKey" in .qalab.json)
#
set -euo pipefail

load_config() {
  local dir="$(pwd)"
  while [ "$dir" != "/" ]; do
    local cfg=""
    if [ -f "$dir/.qalab.json" ]; then
      cfg="$dir/.qalab.json"
    elif [ -f "$dir/qalab.config.json" ]; then
      cfg="$dir/qalab.config.json"
    fi
    if [ -n "$cfg" ]; then
      if command -v jq >/dev/null 2>&1; then
        local api_url project_id base_url workspace db_id framework language
        api_url="$(jq -r '.apiUrl // .coreUrl // empty' "$cfg")"
        project_id="$(jq -r '.projectId // empty' "$cfg")"
        base_url="$(jq -r '.baseUrl // empty' "$cfg")"
        workspace="$(jq -r '.workspacePath // empty' "$cfg")"
        db_id="$(jq -r '.databaseId // empty' "$cfg")"
        framework="$(jq -r '.framework // empty' "$cfg")"
        language="$(jq -r '.language // empty' "$cfg")"
        [ -n "$api_url" ] && API_URL="${QALAB_API_URL:-${API_URL:-$api_url}}"
        [ -n "$project_id" ] && PROJECT_ID="${QALAB_PROJECT_ID:-${PROJECT_ID:-$project_id}}"
        [ -n "$base_url" ] && BASE_URL="${QALAB_BASE_URL:-${BASE_URL:-$base_url}}"
        [ -n "$workspace" ] && WORKSPACE="${QALAB_WORKSPACE:-${WORKSPACE:-$workspace}}"
        [ -n "$db_id" ] && DB_ID="${QALAB_DB_ID:-${DB_ID:-$db_id}}"
        api_key="$(jq -r '.apiKey // empty' "$cfg")"
        [ -n "$api_key" ] && API_KEY="${QALAB_API_KEY:-${API_KEY:-$api_key}}"
        [ -n "$framework" ] && FRAMEWORK="${FRAMEWORK:-$framework}"
        [ -n "$language" ] && LANGUAGE="${LANGUAGE:-$language}"
      else
        API_URL="${QALAB_API_URL:-${API_URL:-$(python3 -c "import sys,json; d=json.load(open('$cfg')); v=d.get('apiUrl') or d.get('coreUrl'); print(v) if v else ''")}}"
        PROJECT_ID="${QALAB_PROJECT_ID:-${PROJECT_ID:-$(python3 -c "import sys,json; d=json.load(open('$cfg')); v=d.get('projectId'); print(v) if v else ''")}}"
        BASE_URL="${QALAB_BASE_URL:-${BASE_URL:-$(python3 -c "import sys,json; d=json.load(open('$cfg')); v=d.get('baseUrl'); print(v) if v else ''")}}"
        WORKSPACE="${QALAB_WORKSPACE:-${WORKSPACE:-$(python3 -c "import sys,json; d=json.load(open('$cfg')); v=d.get('workspacePath'); print(v) if v else ''")}}"
        DB_ID="${QALAB_DB_ID:-${DB_ID:-$(python3 -c "import sys,json; d=json.load(open('$cfg')); v=d.get('databaseId'); print(v) if v else ''")}}"
        API_KEY="${QALAB_API_KEY:-${API_KEY:-$(python3 -c "import sys,json; d=json.load(open('$cfg')); v=d.get('apiKey'); print(v) if v else ''")}}"
        FRAMEWORK="${FRAMEWORK:-$(python3 -c "import sys,json; d=json.load(open('$cfg')); v=d.get('framework'); print(v) if v else 'PLAYWRIGHT_TYPESCRIPT'")}"
        LANGUAGE="${LANGUAGE:-$(python3 -c "import sys,json; d=json.load(open('$cfg')); v=d.get('language'); print(v) if v else 'TypeScript'")}"
      fi
      break
    fi
    dir="$(dirname "$dir")"
  done
}

load_config

API_URL="${QALAB_API_URL:-${API_URL:-http://localhost:8080}}"
PROJECT_ID="${QALAB_PROJECT_ID:-${PROJECT_ID:-qalab-cli}}"
BASE_URL="${QALAB_BASE_URL:-${BASE_URL:-}}"
WORKSPACE="${QALAB_WORKSPACE:-${WORKSPACE:-}}"
DB_ID="${QALAB_DB_ID:-${DB_ID:-}}"
API_KEY="${QALAB_API_KEY:-${API_KEY:-}}"
FRAMEWORK="${FRAMEWORK:-PLAYWRIGHT_TYPESCRIPT}"
LANGUAGE="${LANGUAGE:-TypeScript}"

# Allow --url <value> on any command to override the app base URL:
#   qalab explore --url http://localhost:3000
i=1
while [ $i -le $# ]; do
  arg="${!i}"
  if [ "$arg" = "--url" ]; then
    n=$((i + 1))
    if [ $n -le $# ]; then
      BASE_URL="${!n}"
    else
      echo "error: --url requires a value" >&2
      exit 1
    fi
    break
  fi
  i=$((i + 1))
done

json_get() {
  # json_get <json> <key>
  local json="$1" key="$2"
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$json" | jq -r "$key"
  else
    printf '%s' "$json" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d$key)"
  fi
}

json_id() {
  # json_id <id> - echoes the raw id (quotes stripped)
  local id="$1"
  printf '%s' "${id//\"/}"
}

write_files_from_json() {
  local json="$1"
  local target_dir="${2:-.}"
  
  if command -v jq >/dev/null 2>&1; then
    local count
    count="$(printf '%s' "$json" | jq '.files | length')"
    for ((i=0; i<count; i++)); do
      local path content
      path="$(printf '%s' "$json" | jq -r ".files[$i].path")"
      content="$(printf '%s' "$json" | jq -r ".files[$i].content")"
      mkdir -p "$target_dir/$(dirname "$path")"
      printf '%s' "$content" > "$target_dir/$path"
      echo "Wrote $target_dir/$path"
    done
  else
    printf '%s' "$json" | python3 -c "
import sys, json, os
d = json.load(sys.stdin)
target = sys.argv[1]
for f in d.get('files', []):
    p = f['path']
    full = os.path.join(target, p)
    os.makedirs(os.path.dirname(full), exist_ok=True)
    with open(full, 'w') as out:
        out.write(f['content'])
    print(f'Wrote {full}')
" "$target_dir"
  fi
}

print_healing() {
  # print_healing <json> - human readable healing outcome/proposal
  local json
  if [ -n "${1:-}" ]; then
    json="$1"
  else
    json="$(cat)"
  fi
  if ! command -v jq >/dev/null 2>&1; then
    printf '%s' "$json"
    return
  fi
  local cls conf reason attempt pid
  cls="$(printf '%s' "$json" | jq -r '.classification // empty')"
  conf="$(printf '%s' "$json" | jq -r '.classificationConfidence // empty')"
  reason="$(printf '%s' "$json" | jq -r '.classificationReason // empty')"
  attempt="$(printf '%s' "$json" | jq -r '.healingAttempted // empty')"
  pid="$(printf '%s' "$json" | jq -r '.proposal.proposalId // empty')"
  echo "AI QA SELF-HEALING"
  if [ -z "$cls" ]; then
    printf '%s' "$json"
    return
  fi
  echo "Classification: $cls (confidence: ${conf:-n/a})"
  echo "Reason: ${reason:-n/a}"
  echo "Healing attempted: ${attempt:-false}"
  if [ -n "$pid" ]; then
    echo ""
    echo "Proposal: $pid"
    echo "  Original:    $(printf '%s' "$json" | jq -r '.proposal.originalLocator')"
    echo "  Recommended: $(printf '%s' "$json" | jq -r '.proposal.recommendedLocator')"
    echo "  Confidence:  $(printf '%s' "$json" | jq -r '.proposal.confidence') ($(printf '%s' "$json" | jq -r '.proposal.confidenceLabel'))"
    echo "  Safe to apply: $(printf '%s' "$json" | jq -r '.proposal.safeToApply')"
    echo "  Status:      $(printf '%s' "$json" | jq -r '.proposal.status')"
    echo "  Reason:      $(printf '%s' "$json" | jq -r '.proposal.reason')"
  else
    echo "No healing proposal created."
  fi
}

write_test_plan() {
  # write_test_plan <response-json> <report_dir>
  # The planner produces a full scenario list, but until now it only lived in the
  # database and as a scenarioCount in the response. Persist it in both a readable
  # and a machine-readable form so the plan can be reviewed, diffed and re-run.
  local json report_dir
  json="$1"
  report_dir="$2"

  local count
  count="$(printf '%s' "$json" | jq -r '.steps.testPlan.scenarioCount // 0')"
  if [ "${count:-0}" -eq 0 ]; then
    return 0
  fi

  printf '%s' "$json" | jq '.steps.testPlan' > "$report_dir/test-plan.json"

  if command -v jq >/dev/null 2>&1; then
    {
      echo "# Test Plan"
      echo ""
      echo "- **Scenarios:** $count"
      url="$(printf '%s' "$json" | jq -r '.url // "-"')"
      echo "- **Target:** $url"
      echo ""
      echo "| # | Scenario | Type | Priority | Description |"
      echo "|---|----------|------|----------|-------------|"
      printf '%s' "$json" | jq -r '
        .steps.testPlan.scenarios // [] | to_entries[] |
        "| \(.key + 1) | \(.value.name // "-") | \(.value.type // "-") | \(.value.priority // "-") | \(.value.description // "-") |"'
      echo ""
      echo "## Steps"
      echo ""
      printf '%s' "$json" | jq -r '
        .steps.testPlan.scenarios // [] | to_entries[] |
        "### \(.key + 1). \(.value.name // "Scenario")\n" +
        (if (.value.requiredElements // []) | length > 0
         then "**Required elements:** " + ((.value.requiredElements) | join(", ")) + "\n"
         else "" end) +
        ((.value.steps // []) | to_entries | map("  \(.key + 1). \(.value)") | join("\n")) + "\n"'
    } > "$report_dir/test-plan.md"
  else
    python3 - "$report_dir" <<'PYEOF'
import json, os, sys
report_dir = sys.argv[1]
with open(os.path.join(report_dir, 'report.json')) as fh:
    data = json.load(fh)
plan = (data.get('steps') or {}).get('testPlan') or {}
scenarios = plan.get('scenarios') or []
if not scenarios:
    sys.exit(0)
with open(os.path.join(report_dir, 'test-plan.json'), 'w') as fh:
    json.dump(plan, fh, indent=2)
lines = ['# Test Plan', '',
         f"- **Scenarios:** {len(scenarios)}",
         f"- **Target:** {data.get('url', '-')}", '',
         '| # | Scenario | Type | Priority | Description |',
         '|---|----------|------|----------|-------------|']
for i, s in enumerate(scenarios, 1):
    lines.append('| {} | {} | {} | {} | {} |'.format(
        i, s.get('name', '-'), s.get('type', '-'),
        s.get('priority', '-'), (s.get('description') or '-').replace('|', '\\|')))
lines += ['', '## Steps', '']
for i, s in enumerate(scenarios, 1):
    lines.append(f"### {i}. {s.get('name', 'Scenario')}")
    req = s.get('requiredElements') or []
    if req:
        lines.append('**Required elements:** ' + ', '.join(req))
    lines.append('')
    for j, step in enumerate(s.get('steps') or [], 1):
        lines.append(f'  {j}. {step}')
    lines.append('')
with open(os.path.join(report_dir, 'test-plan.md'), 'w') as fh:
    fh.write('\n'.join(lines))
PYEOF
  fi
}

print_summary() {
  # print_summary <response-json> <report_dir>
  # Human-readable digest of a full-test workflow. Replaces dumping the raw
  # response (which embedded every generated test source) to the terminal.
  local json report_dir
  json="$1"
  report_dir="$2"

  if ! command -v jq >/dev/null 2>&1; then
    printf '%s' "$json"
    return
  fi

  local status url op ws
  status="$(printf '%s' "$json" | jq -r '.status // "UNKNOWN"')"
  url="$(printf '%s' "$json" | jq -r '.url // "-"')"
  op="$(printf '%s' "$json" | jq -r '.operationId // "-"')"
  ws="$(printf '%s' "$json" | jq -r '.steps.execution.workspace // .steps.generatedTests.workspace // empty')"

  echo ""
  echo "QA RUN $status"
  echo "  url        $url"
  echo "  operation  $op"
  [ -n "$ws" ] && echo "  workspace  $ws"

  echo ""
  echo "  PIPELINE"
  local key label value
  for key in explore analyze locators testPlan generatedTests execution failureAnalysis healing bugReport; do
    value="$(printf '%s' "$json" | jq -r --arg k "$key" '.steps[$k].status // empty')"
    [ -z "$value" ] && continue
    label="$key"
    case "$key" in
      testPlan)        label="$label ($(printf '%s' "$json" | jq -r '.steps.testPlan.scenarioCount // 0') scenarios)" ;;
      generatedTests)  label="$label ($(printf '%s' "$json" | jq -r '.steps.generatedTests.count // 0') specs, $(printf '%s' "$json" | jq -r '.steps.generatedTests.pageObjects // [] | length') page objects)" ;;
      locators)        label="$label ($(printf '%s' "$json" | jq -r '.steps.locators.generated // 0') locators)" ;;
    esac
    case "$value" in
      COMPLETED) printf '    %-22s ok\n' "$label" ;;
      SKIPPED)   printf '    %-22s skipped (%s)\n' "$label" "$(printf '%s' "$json" | jq -r --arg k "$key" '.steps[$k].reason // "n/a"')" ;;
      *)         printf '    %-22s %s\n' "$label" "$value" ;;
    esac
  done

  local exec_status exec_dur
  exec_status="$(printf '%s' "$json" | jq -r '.steps.execution.executionStatus // empty')"
  exec_dur="$(printf '%s' "$json" | jq -r '.steps.execution.duration // 0')"
  if [ -n "$exec_status" ]; then
    echo ""
    # Prefer the structured per-test results (B-022). The text fallback only applies to
    # a runner that produced none, so the summary degrades instead of going blank.
    if printf '%s' "$json" | jq -e '.steps.execution.results.tests' >/dev/null 2>&1; then
      printf '  TESTS  %s - ' "$exec_status"
      printf '%s' "$json" | jq -r '"\(.steps.execution.results.passed // 0) passed, \(.steps.execution.results.failed // 0) failed, \(.steps.execution.results.skipped // 0) skipped (\(exec_dur / 1000)s)"'
      local failed_count
      failed_count="$(printf '%s' "$json" | jq -r '.steps.execution.results.failed // 0')"
      if [ "${failed_count:-0}" -gt 0 ]; then
        printf '%s' "$json" | jq -r '
          .steps.execution.results.tests[] | select(.status == "failed") |
          "    ✘ \(.file): \(.title) (\( (.durationMs / 1000) | floor )s)"' | head -8 | sed 's/$/
/'
        local remaining=$(( failed_count > 8 ? failed_count - 8 : 0 ))
        [ "$remaining" -gt 0 ] && printf '    ... and %s more failing test(s)\n' "$remaining"
        # The first real assertion message is the most useful line in the whole report.
        printf '%s' "$json" | jq -r '
          .steps.execution.results.tests[] | select(.status == "failed" and .error != null) |
          "      \(.error | split("\n")[0])"' | head -3 | sed 's/^/    /'
      fi
    else
      echo "  TESTS  $exec_status ($(( exec_dur / 1000 ))s)"
    fi
  fi

  # A workflow that aborts before any step completes leaves only a `workflow` step
  # carrying the reason. Without this the user sees "QA RUN FAILED" and nothing else,
  # which is the least useful possible output.
  local wf_error
  wf_error="$(printf '%s' "$json" | jq -r '.steps.workflow.error // empty' 2>/dev/null)"
  if [ -n "$wf_error" ]; then
    echo ""
    echo "  ERROR"
    printf '%s\n' "$wf_error" | head -6 | sed 's/^/    /'
  fi

  local fa_type fa_summary healing_msg bug_title bug_sev
  fa_type="$(printf '%s' "$json" | jq -r '.steps.failureAnalysis.failureType // empty')"
  fa_summary="$(printf '%s' "$json" | jq -r '.steps.failureAnalysis.summary // empty')"
  if [ -n "$fa_type" ]; then
    echo ""
    echo "  FAILURE ANALYSIS  $fa_type"
    [ -n "$fa_summary" ] && echo "    $fa_summary"
  fi
  healing_msg="$(printf '%s' "$json" | jq -r '.steps.healing.message // empty')"
  if [ -n "$healing_msg" ]; then
    echo "  HEALING  $healing_msg"
  fi
  bug_title="$(printf '%s' "$json" | jq -r '.steps.bugReport.title // empty')"
  bug_sev="$(printf '%s' "$json" | jq -r '.steps.bugReport.severity // empty')"
  if [ -n "$bug_title" ]; then
    echo "  BUG REPORT  [$bug_sev] $bug_title"
  fi

  echo ""
  echo "  ARTIFACTS"
  [ -f "$report_dir/report.json" ] && echo "    $report_dir/report.json"
  [ -f "$report_dir/test-plan.md" ] && echo "    $report_dir/test-plan.md"
  [ -f "$report_dir/bug-report.json" ] && echo "    $report_dir/bug-report.json"
  echo "    (add --json for the full response)"

  if [ "$status" = "COMPLETED" ]; then
    # A completed workflow whose tests failed is still a failed QA run; CI must see it.
    case "$exec_status" in
      FAILED|ERROR|TIMEOUT) return 1 ;;
      *) return 0 ;;
    esac
  fi
  return 1
}

# Every call to the Core goes through here so the bearer header is applied
# consistently. Containing the quoting inside the function matters: an unquoted
# ${auth_args}-style expansion word-splits "Authorization: Bearer <key>" into three
# argv entries and curl then treats "Bearer" and "<key>" as URLs.
# Emits no header when no key is configured, so unauthenticated local setups keep
# working unchanged.
api_curl() {
  if [ -n "$API_KEY" ]; then
    curl -sS -H "Authorization: Bearer $API_KEY" "$@"
  else
    curl -sS "$@"
  fi
}

# Fails fast with an actionable message when the Core demands a key we do not have.
require_auth_if_enforced() {
  [ -n "$API_KEY" ] && return 0
  command -v jq >/dev/null 2>&1 || return 0
  local required
  required="$(api_curl "$API_URL/api/v1/account/bootstrap" 2>/dev/null | jq -r '.apiKeyRequired // false' 2>/dev/null || echo false)"
  if [ "$required" = "true" ]; then
    echo "error: this QALabAI instance requires an API key, but none is configured." >&2
    echo "       Set QALAB_API_KEY=<key>, or add \"apiKey\" to .qalab.json." >&2
    echo "       Create one with: curl -X POST $API_URL/api/v1/account/api-keys" >&2
    exit 1
  fi
}

project_payload() {
  local db=""
  if [ -n "$DB_ID" ]; then
    db=", \"databaseId\": $DB_ID"
  fi
  cat <<EOF
  {
    "projectId": "$PROJECT_ID",
    "baseUrl": "$BASE_URL",
    "framework": "$FRAMEWORK",
    "language": "$LANGUAGE",
    "workspacePath": "$WORKSPACE"$db
  }
EOF
}

require_url() {
  if [ -z "$BASE_URL" ]; then
    echo "error: QALAB_BASE_URL is not set (or use --url)" >&2
    exit 1
  fi
}

usage() {
  grep '^#' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  init)
    dir="${2:-.}"
    mkdir -p "$dir"
    cat > "$dir/.qalab.json" <<EOF
{
  "projectId": "$PROJECT_ID",
  "baseUrl": "$BASE_URL",
  "framework": "$FRAMEWORK",
  "language": "$LANGUAGE",
  "workspacePath": "$WORKSPACE",
  "apiUrl": "$API_URL",
  "databaseId": "$DB_ID",
  "apiKey": "$API_KEY"
}
EOF
    echo "Initialized $dir/.qalab.json"
    ;;
  explore)
    require_url
    instruction=""
    username="${QALAB_USERNAME:-}"
    password="${QALAB_PASSWORD:-}"
    while [ $# -gt 0 ]; do
      case "$1" in
        --instruction) instruction="${2:-}"; shift 2 ;;
        --username) username="${2:-}"; shift 2 ;;
        --password) password="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    payload="$(project_payload)"
    cred_args=""
    [ -n "$instruction" ] && cred_args="$cred_args,\"instruction\":\"$(printf '%s' "$instruction" | sed 's/"/\\"/g')\""
    [ -n "$username" ] && cred_args="$cred_args,\"username\":\"$(printf '%s' "$username" | sed 's/"/\\"/g')\""
    [ -n "$password" ] && cred_args="$cred_args,\"password\":\"$(printf '%s' "$password" | sed 's/"/\\"/g')\""
    api_curl -X POST "$API_URL/api/v1/explore" \
      -H 'Content-Type: application/json' \
      -d "{\"project\":$payload,\"url\":\"$BASE_URL\"$cred_args}" | jq 'del(.screenshotBase64, .analysis.screenshotBase64)' 2>/dev/null || true
    ;;
  analyze)
    require_url
    force="false"
    instruction=""
    username="${QALAB_USERNAME:-}"
    password="${QALAB_PASSWORD:-}"
    while [ $# -gt 0 ]; do
      case "$1" in
        --force) force="true"; shift ;;
        --instruction) instruction="${2:-}"; shift 2 ;;
        --username) username="${2:-}"; shift 2 ;;
        --password) password="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    payload="$(project_payload)"
    cred_args=""
    [ -n "$instruction" ] && cred_args="$cred_args,\"instruction\":\"$(printf '%s' "$instruction" | sed 's/"/\\"/g')\""
    [ -n "$username" ] && cred_args="$cred_args,\"username\":\"$(printf '%s' "$username" | sed 's/"/\\"/g')\""
    [ -n "$password" ] && cred_args="$cred_args,\"password\":\"$(printf '%s' "$password" | sed 's/"/\\"/g')\""
    api_curl -X POST "$API_URL/api/v1/analyze" \
      -H 'Content-Type: application/json' \
      -d "{\"project\":$payload,\"url\":\"$BASE_URL\",\"forceRefresh\":$force$cred_args}" | jq 'del(.screenshotBase64, .analysis.screenshotBase64)' 2>/dev/null || true
    ;;
  plan)
    require_url
    instruction=""
    test_type=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --instruction) instruction="${2:-}"; shift 2 ;;
        --test-type) test_type="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    payload="$(project_payload)"
    inst_arg=""
    [ -n "$instruction" ] && inst_arg=",\"instruction\":\"$(printf '%s' "$instruction" | sed 's/"/\\"/g')\""
    api_curl -X POST "$API_URL/api/v1/test-plan" \
      -H 'Content-Type: application/json' \
      -d "{\"project\":$payload,\"url\":\"$BASE_URL\"$inst_arg}" | jq . 2>/dev/null || true
    ;;
  generate)
    require_url
    write_files="false"
    instruction=""
    test_type=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --write) write_files="true"; shift ;;
        --instruction) instruction="${2:-}"; shift 2 ;;
        --test-type) test_type="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    payload="$(project_payload)"
    inst_arg=""
    type_arg=""
    [ -n "$instruction" ] && inst_arg=",\"instruction\":\"$(printf '%s' "$instruction" | sed 's/"/\\"/g')\""
    [ -n "$test_type" ] && type_arg=",\"testType\":\"$test_type\""
    response="$(api_curl -X POST "$API_URL/api/v1/tests" \
      -H 'Content-Type: application/json' \
      -d "{\"project\":$payload,\"url\":\"$BASE_URL\"$inst_arg$type_arg}")"
    if [ "$write_files" = "true" ]; then
      write_files_from_json "$response" "${WORKSPACE:-.}"
    else
      printf '%s' "$response" | jq . 2>/dev/null || true
    fi
    ;;
  execute)
    healing="false"
    test_id=""
    run_all="false"
    instruction=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --healing-analysis) healing="true"; shift ;;
        --all) run_all="true"; shift ;;
        --test) test_id="${2:-}"; shift 2 ;;
        --instruction) instruction="${2:-}"; shift 2 ;;
        *) test_id="${test_id:-$1}"; shift ;;
      esac
    done
    payload="$(project_payload)"
    inst_arg=""
    [ -n "$instruction" ] && inst_arg=",\"instruction\":\"$(printf '%s' "$instruction" | sed 's/"/\\"/g')\""
    if [ -n "$test_id" ]; then
      api_curl -X POST "$API_URL/api/v1/run" \
        -H 'Content-Type: application/json' \
        -d "{\"project\":$payload,\"testId\":$(json_id "$test_id"),\"healingAnalysis\":$healing$inst_arg}" | jq . 2>/dev/null || true
    elif [ "$run_all" = "true" ] || [ -n "$WORKSPACE" ]; then
      api_curl -X POST "$API_URL/api/v1/run" \
        -H 'Content-Type: application/json' \
        -d "{\"project\":$payload,\"runAll\":true,\"healingAnalysis\":$healing$inst_arg}" | jq . 2>/dev/null || true
    else
      echo "error: execution requires QALAB_WORKSPACE (or --test <id>)" >&2
      exit 1
    fi
    ;;
  heal)
    run_id="${2:?usage: qalab heal <executionId>}"
    payload="$(project_payload)"
    api_curl -X POST "$API_URL/api/v1/healing/propose" \
      -H 'Content-Type: application/json' \
      -d "{\"project\":$payload,\"executionId\":$(json_id "$run_id")}" \
      | print_healing
    ;;
  heal-status)
    proposal_id="${2:?usage: qalab heal-status <proposalId>}"
    api_curl "$API_URL/api/v1/healing/$(json_id "$proposal_id")" | jq . 2>/dev/null || true
    ;;
  locator)
    action="${2:-}"
    case "$action" in
      analyze)
        url=""
        locator=""
        shift 2
        while [ $# -gt 0 ]; do
          case "$1" in
            --url) url="${2:-}"; shift 2 ;;
            --locator) locator="${2:-}"; shift 2 ;;
            *) echo "unknown locator analyze option: $1" >&2; exit 1 ;;
          esac
        done
        if [ -z "$url" ] || [ -z "$locator" ]; then
          echo "usage: qalab locator analyze --url <url> --locator '<locator>'" >&2
          exit 1
        fi
        payload="$(project_payload)"
        api_curl -X POST "$API_URL/api/v1/locators/analyze" \
          -H 'Content-Type: application/json' \
          -d "{\"url\":\"$url\",\"locator\":\"$locator\",\"projectId\":${DB_ID:-null}}" \
          | jq . 2>/dev/null || true
        ;;
      history)
        pid="${3:-${DB_ID:-}}"
        fingerprint="${4:-}"
        if [ -z "$pid" ]; then
          echo "error: locator history requires a project id (or QALAB_DB_ID)" >&2
          exit 1
        fi
        if [ -n "$fingerprint" ]; then
          api_curl "$API_URL/api/v1/projects/$pid/locators/$fingerprint/history" | jq . 2>/dev/null || true
        else
          api_curl "$API_URL/api/v1/projects/$pid/locators/history" | jq . 2>/dev/null || true
        fi
        ;;
      help|-h|--help|"")
        echo "usage: qalab locator analyze|history" >&2
        ;;
      *)
        echo "unknown locator action: $action" >&2
        exit 1
        ;;
    esac
    ;;
  test)
    if [ -n "${2:-}" ] && [ "${2#--}" = "$2" ] && [ -z "$BASE_URL" ]; then
      BASE_URL="$2"
    fi
    require_url
    require_auth_if_enforced
    if [ -z "$WORKSPACE" ]; then
      echo "error: no workspace configured, so the generated tests could not be executed." >&2
      echo "       Set QALAB_WORKSPACE=/path/to/workspace or add \"workspacePath\" to .qalab.json." >&2
      echo "       (Use 'qalab generate' if you only want the files, no execution.)" >&2
      exit 1
    fi
    instruction=""
    test_type=""
    raw_json="false"
    quiet="false"
    username="${QALAB_USERNAME:-}"
    password="${QALAB_PASSWORD:-}"
    while [ $# -gt 0 ]; do
      case "$1" in
        --instruction) instruction="${2:-}"; shift 2 ;;
        --test-type) test_type="${2:-}"; shift 2 ;;
        --username) username="${2:-}"; shift 2 ;;
        --password) password="${2:-}"; shift 2 ;;
        --json) raw_json="true"; shift ;;
        --quiet) quiet="true"; shift ;;
        *) shift ;;
      esac
    done
    payload="$(project_payload)"
    extra_args=""
    [ -n "$instruction" ] && extra_args="$extra_args,\"instruction\":\"$(printf '%s' "$instruction" | sed 's/"/\\"/g')\""
    [ -n "$username" ] && extra_args="$extra_args,\"username\":\"$(printf '%s' "$username" | sed 's/"/\\"/g')\""
    [ -n "$password" ] && extra_args="$extra_args,\"password\":\"$(printf '%s' "$password" | sed 's/"/\\"/g')\""
    [ -n "$test_type" ] && extra_args="$extra_args,\"testType\":\"$test_type\""
    op_id="cli-$(date +%s)-$$"
    post_args=",\"operationId\":\"$op_id\""

    # The workflow is served asynchronously (B-017): the POST returns 202 with an
    # operation id and the work runs off the request thread, so a long run is no
    # longer cut off by a proxy read timeout. We submit, then poll for the result,
    # printing live stage changes to stderr as before.
    ack="$(api_curl -X POST "$API_URL/api/v1/workflows/full-test" \
      -H 'Content-Type: application/json' \
      -d "{\"project\":$payload,\"url\":\"$BASE_URL\"$extra_args$post_args}")"

    if command -v jq >/dev/null 2>&1; then
      ack_status="$(printf '%s' "$ack" | jq -r '.status // empty' 2>/dev/null)"
      if [ "$ack_status" = "REJECTED" ]; then
        echo "error: $(printf '%s' "$ack" | jq -r '.message // "server at capacity"')" >&2
        exit 1
      fi
      [ -n "$ack_status" ] && [ "$quiet" != "true" ] && printf '%s\n' "$ack" >&2
    else
      printf '%s' "$ack" >&2
    fi

    response=""
    last_stage=""
    waited=0
    # QALAB_WAIT_SECONDS caps the client-side wait. The server has its own budget
    # (QALAB_PLAYWRIGHT_TIMEOUT_SECONDS) plus LLM time, so the default is generous;
    # exceeding it is reported as a timeout rather than hanging forever.
    wait_budget="${QALAB_WAIT_SECONDS:-3600}"
    while :; do
      sleep 2
      waited=$(( waited + 2 ))

      body="$(api_curl "$API_URL/api/v1/workflows/$op_id" 2>/dev/null || true)"
      if [ -n "$body" ]; then
        http_state="$(printf '%s' "$body" | jq -r '.status // empty' 2>/dev/null)"
        if [ -n "$http_state" ] && [ "$http_state" != "QUEUED" ] && [ "$http_state" != "RUNNING" ]; then
          response="$body"
          break
        fi
        if [ -n "$http_state" ] && [ "$http_state" = "COMPLETED" ]; then
          response="$body"
          break
        fi
        # Surface the live stage, same as the old progress polling did.
        stage="$(printf '%s' "$body" | jq -r '.stage // empty' 2>/dev/null)"
        if [ -z "$stage" ]; then
          prog="$(api_curl "$API_URL/api/v1/workflows/$op_id/progress" 2>/dev/null || true)"
          stage="$(printf '%s' "$prog" | jq -r '.stage // empty' 2>/dev/null || true)"
          message="$(printf '%s' "$prog" | jq -r '.message // empty' 2>/dev/null || true)"
        else
          message="$(printf '%s' "$body" | jq -r '.message // empty' 2>/dev/null || true)"
        fi
        if [ -n "$stage" ] && [ "$stage" != "$last_stage" ]; then
          [ "$quiet" = "true" ] || printf '%s\n' "${message:-$stage}" >&2
          last_stage="$stage"
        fi
      fi

      if [ "$waited" -ge "$wait_budget" ]; then
        echo "error: timed out after ${wait_budget}s waiting for operation $op_id." >&2
        echo "       The workflow may still be running server-side; check:" >&2
        echo "       curl $API_URL/api/v1/workflows/$op_id" >&2
        exit 1
      fi
    done

    if [ -z "$response" ]; then
      echo "error: no result returned for operation $op_id" >&2
      exit 1
    fi
    report_dir="${QALAB_REPORT_DIR:-$(pwd)/.qalab/reports/$(date +%Y%m%d-%H%M%S)}"
    mkdir -p "$report_dir"
    printf '%s' "$response" > "$report_dir/report.json"

    if command -v jq >/dev/null 2>&1; then
      # Specs and page objects must both be persisted: the specs import
      # '../pages/<Class>_<scenario>', so writing specs alone yields a tree
      # that cannot compile.
      files_json="$(printf '%s' "$response" | jq -c '{files: ((.steps.generatedTests.files // []) + (.steps.generatedTests.pageObjects // []))}')"
      if [ "$(printf '%s' "$files_json" | jq '.files | length')" -gt 0 ]; then
        write_files_from_json "$files_json" "$WORKSPACE"
      fi
      write_test_plan "$response" "$report_dir"
      bug_id="$(printf '%s' "$response" | jq -r '.steps.bugReport.reportId // empty')"
      if [ -n "$bug_id" ]; then
        api_curl "$API_URL/api/v1/bug-reports/$bug_id" > "$report_dir/bug-report.json"
      fi
    fi

    if [ "$raw_json" = "true" ]; then
      printf '%s' "$response" | jq . 2>/dev/null || printf '%s' "$response"
      status="$(printf '%s' "$response" | jq -r '.status // "FAILED"')"
      [ "$status" = "COMPLETED" ] || exit 1
    elif [ "$quiet" = "true" ]; then
      printf '%s\n' "$report_dir"
    else
      # print_summary returns non-zero unless the workflow completed cleanly,
      # which becomes this command's exit code for CI use.
      print_summary "$response" "$report_dir" || exit 1
    fi
    ;;
  report)
    if [ -n "${2:-}" ]; then
      api_curl "$API_URL/api/v1/reports/$2" | jq . 2>/dev/null || true
    else
      api_curl "$API_URL/api/v1/reports" | jq . 2>/dev/null || true
    fi
    ;;
  bug-report)
    execution_id="${2:?usage: qalab bug-report <executionId>}"
    instruction=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --instruction) instruction="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    payload="$(project_payload)"
    inst_arg=""
    [ -n "$instruction" ] && inst_arg=",\"instruction\":\"$(printf '%s' "$instruction" | sed 's/"/\\"/g')\""
    api_curl -X POST "$API_URL/api/v1/bug-reports" \
      -H 'Content-Type: application/json' \
      -d "{\"project\":$payload,\"executionId\":$(json_id "$execution_id")}" | jq . 2>/dev/null || true
    ;;
  bug-reports)
    if [ -n "${2:-}" ]; then
      api_curl "$API_URL/api/v1/projects/$2/bug-reports" | jq . 2>/dev/null || true
    else
      api_curl "$API_URL/api/v1/bug-reports" | jq . 2>/dev/null || true
    fi
    ;;
  intent)
    require_url
    prompt="${2:?usage: qalab intent \"<prompt>\"}"
    payload="$(project_payload)"
    api_curl -X POST "$API_URL/api/v1/intent/run" \
      -H 'Content-Type: application/json' \
      -d "{\"project\":$payload,\"prompt\":\"$prompt\",\"url\":\"$BASE_URL\"}" | jq . 2>/dev/null || true
    ;;
  budget-policy)
    if [ "${2:-}" = "set" ]; then
      policy="${3:?usage: qalab budget-policy set <HARD|SOFT|NONE>}"
      api_curl -X PATCH "$API_URL/api/v1/account/budget-policy" \
        -H 'Content-Type: application/json' \
        -d "{\"policy\":\"$policy\"}" | jq . 2>/dev/null || true
    else
      api_curl "$API_URL/api/v1/account/budget-policy" | jq . 2>/dev/null || true
    fi
    ;;
  help|-h|--help|"")
    usage
    ;;
  *)
    echo "unknown command: $1" >&2
    usage >&2
    exit 1
    ;;
esac
